<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para poder hablar con la API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 16 (API 36) estrenó la "Local Network Protection": INTERNET ya no
      alcanza para conectarse a una direccion de la RED LOCAL, hace falta este
      permiso aparte y ademas concederlo en tiempo de ejecucion.

      Nos afecta de lleno porque el backend de desarrollo corre en la PC:
        10.0.2.2       -> asi ve el emulador al localhost de la maquina
        192.168.x.x    -> la PC vista desde un celular en la misma WiFi

      Sin esto, en un emulador con Android 16+ las requests no fallan con un
      error claro: se quedan colgadas hasta el timeout, como si el servidor no
      existiera. En dispositivos con Android 15 o anterior el permiso se ignora.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ronda">

        <!-- Unica Activity de la app: solo hospeda el NavHost. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
