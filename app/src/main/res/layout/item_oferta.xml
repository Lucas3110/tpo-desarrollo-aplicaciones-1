<?xml version="1.0" encoding="utf-8"?>
<!-- Una oferta o contraoferta del historial de una publicacion: monto y
     estado, quien la hizo, el mensaje si lo hubo, la fecha, cuanto falta
     para que venza (solo pendientes) y los botones que el backend habilita
     para quien esta mirando. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMontoOferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="$ 160.000" />

        <TextView
            android:id="@+id/tvEstadoOferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Pendiente"
            tools:textColor="@color/estado_pendiente" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAutorOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#666666"
        android:textSize="14sp"
        tools:text="Oferta de Sofía Ramírez" />

    <TextView
        android:id="@+id/tvMensajeOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="“160 y lo paso a buscar hoy”"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvFechaOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#999999"
        android:textSize="12sp"
        tools:text="15/09/2026 19:50" />

    <TextView
        android:id="@+id/tvVenceOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/estado_pendiente"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Vence en 47 h"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/llAccionesOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/btnAceptarOferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/estado_aceptada"
            android:text="@string/oferta_aceptar" />

        <Button
            android:id="@+id/btnRechazarOferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/estado_rechazada"
            android:text="@string/oferta_rechazar" />
    </LinearLayout>
</LinearLayout>
