<?xml version="1.0" encoding="utf-8"?>
<!-- Home: explorar publicaciones (Punto 3).
     Arriba el encabezado, debajo el contador y el resto es la lista. Los
     estados cargando / vacio / error viven en el mismo FrameLayout que la
     lista y HomeFragment muestra uno solo a la vez. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCerrarSesion"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_cerrar_sesion" />

    </LinearLayout>

    <!-- Buscador: escribe, toca la lupa (o la del teclado) y se pide la
         pagina 1 con q. La "x" aparece solo cuando hay texto. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:hint="@string/home_buscar_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnLimpiarBusqueda"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/home_limpiar_busqueda_desc"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnBuscar"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/home_buscar_desc"
            android:src="@android:drawable/ic_menu_search" />

    </LinearLayout>

    <!-- Filtros y orden. El boton despliega el panel de abajo; cambiar el
         orden recarga desde la pagina 1 conservando busqueda y filtros. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnFiltros"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/home_filtros" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_ordenar_por"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spOrden"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Panel de filtros, plegado por defecto. La unica forma de aplicar lo
         que se edita aca es el boton "Aplicar"; plegarlo descarta lo editado. -->
    <LinearLayout
        android:id="@+id/panelFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_categoria"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPrecioMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/home_precio_min"
                android:inputType="number"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etPrecioMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/home_precio_max"
                android:inputType="number"
                android:maxLines="1" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_estado_articulo"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbNuevo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_nuevo" />

            <CheckBox
                android:id="@+id/cbComoNuevo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_como_nuevo" />

            <CheckBox
                android:id="@+id/cbUsado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_usado" />

        </LinearLayout>

        <!-- Cercania como filtro: publicaciones de la zona de la persona.
             Deshabilitado (con la explicacion) si la sesion no tiene zona. -->
        <CheckBox
            android:id="@+id/cbSoloMiZona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_solo_mi_zona_sin_zona"
            tools:text="Solo mi zona (Palermo)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLimpiarFiltros"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_limpiar" />

            <Button
                android:id="@+id/btnAplicarFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_aplicar" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvContador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:text="10 de 22 publicaciones" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvPublicaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_publicacion" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grupoVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/home_vacio_sin_filtros"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnActualizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_actualizar" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                tools:text="No pudimos conectarnos con el servidor" />

            <TextView
                android:id="@+id/tvUrlBase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="Servidor: http://10.0.2.2:3000/" />

            <Button
                android:id="@+id/btnReintentar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_reintentar" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
