<?xml version="1.0" encoding="utf-8"?>
<!-- Una operacion del historial: articulo (foto y titulo), monto final,
     fecha y contraparte (tocarla abre su perfil publico). Abajo, el estado
     de la calificacion: el boton para calificar con los dias que quedan, las
     estrellas que puse, o el aviso de que el plazo vencio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivFoto"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/historial_foto_desc"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            tools:text="Notebook Lenovo IdeaPad" />

        <TextView
            android:id="@+id/tvMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="$ 185.000" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            tools:text="16/09/2026 15:30" />

        <TextView
            android:id="@+id/tvContraparte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            tools:text="Vendedor: Sofía Ramírez" />

        <TextView
            android:id="@+id/tvRecibida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Te calificó: ★★★★★"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCalificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Te quedan 6 días para calificar"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnCalificar"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/historial_calificar"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</LinearLayout>
