<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/tvTituloMia" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="17sp" />
    <TextView android:id="@+id/tvDatosMia" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <Button android:id="@+id/btnCambiarEstado" style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />
</LinearLayout>
