<?xml version="1.0" encoding="utf-8"?>
<!-- Historial (Punto 9): compras y ventas concretadas. Por ahora es solo el
     cascaron de la pantalla (titulo y un texto); la lista, los filtros y el
     calificar llegan en los pasos siguientes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.historial.HistorialFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:text="@string/historial_titulo"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
