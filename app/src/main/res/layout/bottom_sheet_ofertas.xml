<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ofertas"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp" />

    <ProgressBar
        android:id="@+id/pbLoadingOfertas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvSinOfertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay ofertas."
        android:textAlignment="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOfertas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/llHacerOferta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FAFAFA"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical" />

        <EditText
            android:id="@+id/etMontoOferta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Monto"
            android:inputType="numberDecimal"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnEnviarOferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ofertar" />
    </LinearLayout>

</LinearLayout>
