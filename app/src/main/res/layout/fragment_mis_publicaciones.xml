<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <Button android:id="@+id/btnNuevaPublicacion" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/publicar_nueva" />
    <TextView android:id="@+id/tvResumenMias" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    <Spinner android:id="@+id/spFiltroEstado" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" />
    <ProgressBar android:id="@+id/pbMias" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center" />
    <TextView android:id="@+id/tvEstadoMias" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" />
    <ListView android:id="@+id/lvMias" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
