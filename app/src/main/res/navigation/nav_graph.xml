<?xml version="1.0" encoding="utf-8"?>
<!--
  Grafo raíz. No define pantallas: solo incluye los dos sub-grafos, el de
  autenticación (Punto 1) y el del Home (el resto de la app).
  La app arranca en el de autenticación (startDestination).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_nav_graph">

    <include app:graph="@navigation/auth_nav_graph" />
    <include app:graph="@navigation/home_nav_graph" />

</navigation>
