<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.ronda.ui.home.HomeFragment"
        android:label="Ronda"
        tools:layout="@layout/fragment_home">

        <!-- Cerrar sesion: vuelve al login y limpia el graph del home. -->
        <action
            android:id="@+id/action_home_to_auth"
            app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph"
            app:popUpToInclusive="true" />

        <!-- Punto 2: mi perfil. -->
        <action
            android:id="@+id/action_home_to_perfil"
            app:destination="@id/perfilFragment" />
        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detallePublicacionFragment" />
        <action android:id="@+id/action_home_to_publicar" app:destination="@id/publicarFragment" />
        <action android:id="@+id/action_home_to_mis_publicaciones" app:destination="@id/misPublicacionesFragment" />

        <action
            android:id="@+id/action_home_to_misOfertas"
            app:destination="@id/misOfertasFragment" />
            
        <action
            android:id="@+id/action_home_to_favoritos"
            app:destination="@id/favoritosFragment" />
    </fragment>

    <!-- Punto 2: perfil publico de otra persona (o el propio, visto desde afuera) -->
    <fragment
        android:id="@+id/perfilPublicoFragment"
        android:name="com.example.ronda.ui.perfil.PerfilPublicoFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil_publico">
        <argument
            android:name="usuarioId"
            app:argType="integer" />

        <!-- Sus publicaciones activas abren el detalle. -->
        <action
            android:id="@+id/action_perfilPublico_to_detalle"
            app:destination="@id/detallePublicacionFragment" />
    </fragment>

    <!-- Punto 7: ofertas y negociacion -->
    <fragment
        android:id="@+id/misOfertasFragment"
        android:name="com.example.ronda.ui.ofertas.MisOfertasFragment"
        android:label="Mis ofertas"
        tools:layout="@layout/fragment_mis_ofertas">

        <!-- Tocar una oferta abre la publicacion a la que pertenece. -->
        <action
            android:id="@+id/action_misOfertas_to_detalle"
            app:destination="@id/detallePublicacionFragment" />

        <!-- Tocar la contraparte abre su perfil publico. -->
        <action
            android:id="@+id/action_misOfertas_to_perfilPublico"
            app:destination="@id/perfilPublicoFragment" />

        <!-- Sesion vencida (401): se vuelve al login. -->
        <action
            android:id="@+id/action_misOfertas_to_auth"
            app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/publicarFragment"
        android:name="com.example.ronda.ui.publicar.PublicarFragment"
        android:label="Publicar artículo"
        tools:layout="@layout/fragment_publicar">
        <action android:id="@+id/action_publicar_to_mis_publicaciones" app:destination="@id/misPublicacionesFragment" />
        <action android:id="@+id/action_publicar_to_auth" app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/misPublicacionesFragment"
        android:name="com.example.ronda.ui.publicar.MisPublicacionesFragment"
        android:label="Mis publicaciones"
        tools:layout="@layout/fragment_mis_publicaciones">
        <action android:id="@+id/action_mis_publicaciones_to_publicar" app:destination="@id/publicarFragment" />
        <action android:id="@+id/action_mis_publicaciones_to_auth" app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph" app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/detallePublicacionFragment"
        android:name="com.example.ronda.ui.home.DetallePublicacionFragment"
        android:label="Detalle de Publicación"
        tools:layout="@layout/fragment_detalle_publicacion">
        <argument
            android:name="publicacionId"
            app:argType="integer" />

        <!-- "Ver perfil publico" del vendedor (y de quien oferto, si soy el vendedor). -->
        <action
            android:id="@+id/action_detalle_to_perfilPublico"
            app:destination="@id/perfilPublicoFragment" />
    </fragment>

    <!-- Punto 2 -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.ronda.ui.perfil.PerfilFragment"
        android:label="Mi perfil"
        tools:layout="@layout/fragment_perfil">

        <!-- Sesion vencida (401) al pedir o guardar: se vuelve al login. -->
        <action
            android:id="@+id/action_perfil_to_auth"
            app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph"
            app:popUpToInclusive="true" />

        <!-- "Ver mi perfil publico": como me ve el resto. -->
        <action
            android:id="@+id/action_perfil_to_perfilPublico"
            app:destination="@id/perfilPublicoFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.ronda.ui.favoritos.FavoritosFragment"
        android:label="Favoritos y Búsquedas"
        tools:layout="@layout/fragment_favoritos">
        
        <action android:id="@+id/action_favoritos_to_detalle"
            app:destination="@id/detallePublicacionFragment" />
    </fragment>

</navigation>
