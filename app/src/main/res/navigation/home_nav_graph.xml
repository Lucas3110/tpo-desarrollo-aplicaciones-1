<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.ronda.ui.home.HomeFragment"
        android:label="Ronda"
        tools:layout="@layout/fragment_home">

        <!-- Cerrar sesion: vuelve al login y limpia el graph del home. -->
        <action
            android:id="@+id/action_home_to_auth"
            app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph"
            app:popUpToInclusive="true" />

        <!-- Punto 2: mi perfil. -->
        <action
            android:id="@+id/action_home_to_perfil"
            app:destination="@id/perfilFragment" />
        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detallePublicacionFragment" />
        <action android:id="@+id/action_home_to_publicar" app:destination="@id/publicarFragment" />
        <action android:id="@+id/action_home_to_mis_publicaciones" app:destination="@id/misPublicacionesFragment" />
    </fragment>

    <fragment android:id="@+id/publicarFragment"
        android:name="com.example.ronda.ui.publicar.PublicarFragment"
        android:label="Publicar artículo"
        tools:layout="@layout/fragment_publicar">
        <action android:id="@+id/action_publicar_to_mis_publicaciones" app:destination="@id/misPublicacionesFragment" />
        <action android:id="@+id/action_publicar_to_auth" app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <fragment android:id="@+id/misPublicacionesFragment"
        android:name="com.example.ronda.ui.publicar.MisPublicacionesFragment"
        android:label="Mis publicaciones"
        tools:layout="@layout/fragment_mis_publicaciones">
        <action android:id="@+id/action_mis_publicaciones_to_publicar" app:destination="@id/publicarFragment" />
        <action android:id="@+id/action_mis_publicaciones_to_auth" app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph" app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/detallePublicacionFragment"
        android:name="com.example.ronda.ui.home.DetallePublicacionFragment"
        android:label="Detalle de Publicación"
        tools:layout="@layout/fragment_detalle_publicacion">
        <argument
            android:name="publicacionId"
            app:argType="integer" />
    </fragment>

    <!-- Punto 2 -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.ronda.ui.perfil.PerfilFragment"
        android:label="Mi perfil"
        tools:layout="@layout/fragment_perfil">

        <!-- Sesion vencida (401) al pedir o guardar: se vuelve al login. -->
        <action
            android:id="@+id/action_perfil_to_auth"
            app:destination="@id/auth_nav_graph"
            app:popUpTo="@id/home_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Los Puntos 3 a 6 cuelgan sus pantallas de aca -->

</navigation>
